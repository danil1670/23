<Window x:Class="_23.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_23"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="600" Background="LightBlue">

    <Window.Resources>
        <ControlTemplate x:Key="ErrorTemplate">
            <StackPanel>
                <Border BorderBrush="Red" BorderThickness="2">
                    <AdornedElementPlaceholder/>
                </Border>
                <TextBlock Foreground="Red" FontSize="12"
               Text="{Binding [0].ErrorContent}" />
            </StackPanel>
        </ControlTemplate>

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Foreground" Value="Black" />
        </Style>

        <Style TargetType="Button" x:Key="ButtonRegistration">
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="Background" Value="DarkBlue" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Verdana" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="5" />
            <Style.Triggers>

                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=txtName}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=txtGroup}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=txtAge}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChecked, ElementName=chkAgree}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding (Validation.HasError), ElementName=grCourse}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Регистрация" Grid.Column="0" Grid.Row="0" FontSize="40" FontWeight="Bold" Grid.ColumnSpan="2" />

        <TextBlock Text="ФИО: "   Grid.Column="0" Grid.Row="1" />
        <TextBox  x:Name="txtName" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding FIO, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="1" Margin="10"/>

        <TextBlock Text="Группа: "  Grid.Column="0" Grid.Row="2" />
        <TextBox  x:Name="txtGroup" Validation.ErrorTemplate="{StaticResource ErrorTemplate}" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1"


Grid.Row="2" Margin="10"/>

        <TextBlock Text="Возраст: "   Grid.Column="0" Grid.Row="3" />
        <TextBox x:Name="txtAge" Validation.ErrorTemplate="{StaticResource ErrorTemplate}"  Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Grid.Column="1" Grid.Row="3" Margin="10"/>


        <TextBlock Text="Курс: " Grid.Column="0" Grid.Row="4"/>
        <ComboBox x:Name="grCourse"  Grid.Column="1"  Grid.Row="4" Margin="11"  SelectedValue="{Binding Course, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{StaticResource ErrorTemplate}"/>
        <CheckBox x:Name="chkAgree"  Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Margin="10" FontSize="15" >Согласен с условиями</CheckBox>
        <Button Content="Зарегистрироваться" Style="{StaticResource ButtonRegistration}" Height="30" Click="Reg_Click" Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" Margin="10"/>



    </Grid>
</Window>
